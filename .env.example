# ============================================================
#  IR Project 2026 — configuration
#  Copy this file to `.env` and adjust as needed:  cp .env.example .env
# ============================================================

# ---- Datasets (ir-datasets IDs) — CHANGE DATASETS HERE ONLY ----
# One comma-separated catalog. The whole codebase is dataset-agnostic; nothing else
# references a concrete ID, and callers can only act on ids listed here (allow-list).
# The FIRST entry is the primary/required dataset; the rest are BONUS (TA update:
# only the first is required; a bonus dataset counts only if it mirrors ALL features).
# Add or remove a dataset by editing this one line.
DATASETS=beir/quora/test,wikir/en1k/test

# ---- Service ports (host side) ----
API_GATEWAY_PORT=8000
PREPROCESSING_PORT=8001
INDEXING_PORT=8002
REPRESENTATION_PORT=8003
RETRIEVAL_PORT=8004
QUERY_REFINEMENT_PORT=8005
EVALUATION_PORT=8006
DOC_STORE_PORT=8007
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081
UI_PORT=8501
# Verification Console (dev/QA observability UI; reverse-proxies every service).
DASHBOARD_PORT=8090

# ---- Internal service URLs (used by the gateway, over the compose network) ----
# The dashboard-service also proxies to the gateway itself, so it gets a URL too.
API_GATEWAY_URL=http://api-gateway:8000
PREPROCESSING_URL=http://preprocessing-service:8001
INDEXING_URL=http://indexing-service:8002
REPRESENTATION_URL=http://representation-service:8003
RETRIEVAL_URL=http://retrieval-service:8004
QUERY_REFINEMENT_URL=http://query-refinement-service:8005
EVALUATION_URL=http://evaluation-service:8006
DOC_STORE_URL=http://doc-store-service:8007

# ---- Models ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
WORD2VEC_MODEL=word2vec-google-news-300

# ---- Paths (inside containers) ----
DATA_DIR=/app/data
ARTIFACTS_DIR=/app/data/artifacts
# Datasets are downloaded ONCE into this folder and kept permanently (offline after).
# Fetched only via the doc-store POST /dataset/download endpoint.
IR_DATASETS_HOME=/app/data/dataset

# ---- Document store: dataset facts in MongoDB, read BY ID at query time (TA — graded) ----
# Three collections, one per fact type: raw docs (graded original-by-id), test queries,
# and relevance judgments (qrels) — all ingested offline by POST /dataset/prepare.
MONGO_URL=mongodb://doc-store-db:27017
MONGO_DB=ir_project
MONGO_DOCS_COLLECTION=documents
MONGO_QUERIES_COLLECTION=queries
MONGO_QRELS_COLLECTION=qrels
# Raw docs ingested into Mongo per insert_many batch (offline prepare).
DOC_STORE_INGEST_BATCH_SIZE=5000

# ---- App ----
LOG_LEVEL=DEBUG
ENV=development

# ---- Preprocessing ----
# Max texts accepted by /preprocess/batch in one call (callers chunk corpora).
# Service-prefixed: the shared .env reaches every container via compose.
PREPROCESSING_MAX_BATCH_SIZE=5000

# ---- Representation (TF-IDF / VSM; BM25 & embeddings later) ----
# Docs per /preprocess/batch call while fitting a representation (≤ PREPROCESSING_MAX_BATCH_SIZE).
REPRESENTATION_PREPROCESS_BATCH_SIZE=1000
